# ----------------------------------------------------------------------------
# Copy this file to `.env` for local dev. NEVER commit `.env`.
# On Netlify, set these in: Site settings -> Environment variables.
# ----------------------------------------------------------------------------

# Anthropic API key (server-side only, used by Netlify Functions).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key (server-side only — full DB access, keep secret).
# Settings -> API -> service_role. Used ONLY inside Netlify Functions.
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase ANON key (safe to expose to the browser; RLS protects data).
# Settings -> API -> anon public. Prefixed VITE_ so the front-end can read it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
